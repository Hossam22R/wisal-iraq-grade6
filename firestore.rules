rules_version = '2';
// قواعد حماية بوابة مدارس براعم كربلاء الأهلية
// المالك: مشرف القنوات وكل الصلاحيات.
// مشرف الواجبات: ينشر الواجبات فقط (العادية والإلكترونية)، ولصفوفه المحددة إن حُددت، ويعدّل ويحذف ما نشره هو.
// ولي الأمر والتلميذ: دخول مجهول تلقائي، ويدخل صف ابنه برمز الصف، فيرى محتوى ذلك الصف فقط.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAnon() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(userDoc()).data; }
    function isStaff() { return signedIn() && !isAnon() && exists(userDoc()) && me().active == true; }
    function isOwner() { return isStaff() && me().role == 'owner'; }
    function str(v, n) { return v is string && v.size() <= n; }
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    function changed(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // المحتوى العام: الموجّه للمدرسة كلها أو لمرحلة كاملة
    function isPublicGrade(g) { return g == '' || g.matches('مرحلة:.*'); }
    // عضو في صف: دخل برمز الصف
    function member(g) { return signedIn() && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '__' + g)); }
    // صفوف مشرف الواجبات (فارغة = كل الصفوف)
    function gradeAllowed(g) { return !('gradesList' in me()) || me().gradesList.size() == 0 || g in me().gradesList; }
    function canPost(t, g) { return isOwner() || (isStaff() && t == 'homework' && gradeAllowed(g)); }

    // تسجيل المالك الأول مرة واحدة فقط
    match /meta/owner {
      allow read: if true;
      allow create: if signedIn() && !isAnon() && onlyKeys(['uid', 'at']) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // حسابات المالك ومشرفي الواجبات
    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow create: if
        (signedIn() && !isAnon() && uid == request.auth.uid
          && !exists(/databases/$(database)/documents/meta/owner)
          && getAfter(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid
          && request.resource.data.role == 'owner' && request.resource.data.active == true)
        || (isOwner() && request.resource.data.role == 'supervisor');
      allow update: if isOwner() && (uid != request.auth.uid || (request.resource.data.role == 'owner' && request.resource.data.active == true));
      allow delete: if false;
    }

    // دليل التواصل العام
    match /directory/{uid} {
      allow read: if true;
      allow write: if isOwner();
    }

    // بيانات المدرسة والمراحل
    match /settings/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // رموز الصفوف: يعرف الرمز من يملكه فقط، ولا يمكن سرد الرموز إلا للمالك
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if isOwner();
      allow write: if isOwner();
    }

    // عضوية أولياء الأمور في الصفوف
    match /memberships/{id} {
      allow get, list: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '__' + request.resource.data.grade
        && onlyKeys(['uid', 'grade', 'code', 'parentName', 'studentName', 'at'])
        && str(request.resource.data.parentName, 80) && str(request.resource.data.studentName, 80)
        && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.code)).data.grade == request.resource.data.grade;
      allow update: if false;
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // المنشورات
    function validPost() {
      return request.resource.data.type in ['channels', 'announcements', 'homework', 'exams', 'lessons', 'events', 'activities']
        && request.resource.data.grade is string
        && request.resource.data.public == isPublicGrade(request.resource.data.grade)
        && str(request.resource.data.title, 200)
        && (!('body' in request.resource.data) || str(request.resource.data.body, 6000));
    }
    match /posts/{id} {
      allow read: if resource.data.public == true || isStaff() || member(resource.data.grade);
      allow create: if isStaff() && request.resource.data.authorUid == request.auth.uid && validPost()
        && canPost(request.resource.data.type, request.resource.data.grade);
      allow update: if isStaff() && validPost() && request.resource.data.authorUid == resource.data.authorUid
        && (isOwner() || (resource.data.authorUid == request.auth.uid && canPost(request.resource.data.type, request.resource.data.grade)));
      allow delete: if isStaff() && (isOwner() || resource.data.authorUid == request.auth.uid);
    }

    // الاختبارات والواجبات الإلكترونية: لأعضاء الصف والكادر فقط
    function canExam(d) { return isOwner() || (isStaff() && d.type == 'homework' && gradeAllowed(d.grade)); }
    match /exams/{id} {
      allow read: if isStaff() || member(resource.data.grade);
      allow create: if isStaff() && request.resource.data.authorUid == request.auth.uid && str(request.resource.data.title, 200) && canExam(request.resource.data);
      allow update: if isStaff() && request.resource.data.authorUid == resource.data.authorUid
        && (isOwner() || (resource.data.authorUid == request.auth.uid && canExam(request.resource.data)));
      allow delete: if isStaff() && (isOwner() || resource.data.authorUid == request.auth.uid);
    }
    match /examKeys/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && (isOwner() || getAfter(/databases/$(database)/documents/exams/$(id)).data.authorUid == request.auth.uid);
      allow delete: if isStaff() && (isOwner() || get(/databases/$(database)/documents/exams/$(id)).data.authorUid == request.auth.uid);
    }

    // محاولات التلاميذ
    match /attempts/{id} {
      allow get: if signedIn();
      allow list: if isStaff();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && onlyKeys(['examId', 'uid', 'name', 'grade', 'section', 'answers', 'order', 'startedAt', 'submittedAt', 'leaves', 'timeout'])
        && str(request.resource.data.name, 80) && str(request.resource.data.section, 20)
        && request.resource.data.answers is list && request.resource.data.answers.size() <= 200
        && get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.status == 'open';
      allow update: if isStaff() && changed(['result']);
      allow delete: if isOwner();
    }

    // الدردشة الخاصة: محادثة لكل ولي أمر برمز سري
    match /threads/{tid} {
      allow get: if signedIn();
      allow list: if isOwner() || (isStaff() && resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid
        && onlyKeys(['to', 'toName', 'parentUid', 'parentName', 'studentName', 'grade', 'section', 'createdAt', 'updatedAt', 'lastFrom', 'unreadStaff', 'unreadParent', 'status'])
        && exists(/databases/$(database)/documents/directory/$(request.resource.data.to))
        && str(request.resource.data.parentName, 80) && str(request.resource.data.studentName, 80)
        && str(request.resource.data.section, 20);
      allow update: if signedIn() && changed(['updatedAt', 'lastFrom', 'unreadStaff', 'unreadParent', 'status']);
      allow delete: if isOwner();

      match /msgs/{mid} {
        allow read: if signedIn();
        allow create: if signedIn() && onlyKeys(['from', 'text', 'at', 'by', 'byName'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 3000
          && existsAfter(/databases/$(database)/documents/threads/$(tid))
          && (request.resource.data.from == 'parent'
            || (request.resource.data.from == 'staff' && request.resource.data.by == request.auth.uid
                && (isOwner() || (isStaff() && get(/databases/$(database)/documents/threads/$(tid)).data.to == request.auth.uid))));
        allow update, delete: if false;
      }
    }
  }
}
